generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum PaymentMethod {
  CASH
  CREDIT_CARD
  DEBIT_CARD
  UPI
  NET_BANKING
}

enum LoanType {
  LENT
  BORROWED
}

enum LoanStatus {
  PENDING
  PARTIAL
  SETTLED
}

model User {
  id           String     @id @default(uuid())
  name         String
  email        String     @unique
  passwordHash String     @map("password_hash")
  role         Role       @default(USER)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  expenses     Expense[]
  budgets      Budget[]
  contacts     Contact[]
  loans        Loan[]

  @@index([email], name: "idx_user_email")
  @@map("users")
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  icon      String
  color     String
  createdAt DateTime  @default(now()) @map("created_at")

  expenses  Expense[]
  budgets   Budget[]

  @@map("categories")
}

model Expense {
  id            String        @id @default(uuid())
  userId        String        @map("user_id")
  categoryId    Int           @map("category_id")
  amount        Decimal       @db.Decimal(12, 2)
  description   String?
  paymentMethod PaymentMethod @map("payment_method")
  expenseDate   DateTime      @map("expense_date") @db.Date
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  category      Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([userId, expenseDate], name: "idx_user_expense_date")
  @@index([userId, categoryId, expenseDate], name: "idx_user_category_date")
  @@map("expenses")
}

model Budget {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  categoryId Int      @map("category_id")
  amount     Decimal  @db.Decimal(12, 2)
  month      Int      @db.SmallInt
  year       Int      @db.SmallInt
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId, month, year], name: "uq_user_category_period")
  @@index([userId, year, month], name: "idx_user_period")
  @@map("budgets")
}

model Contact {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  name      String
  email     String?
  phone     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  loans     Loan[]

  @@unique([userId, name], name: "uq_user_contact_name")
  @@index([userId], name: "idx_user_contact")
  @@map("contacts")
}

model Loan {
  id              String           @id @default(uuid())
  userId          String           @map("user_id")
  contactId       String           @map("contact_id")
  type            LoanType
  amount          Decimal          @db.Decimal(12, 2)
  remainingAmount Decimal          @map("remaining_amount") @db.Decimal(12, 2)
  description     String?
  status          LoanStatus       @default(PENDING)
  loanDate        DateTime         @map("loan_date") @db.Date
  dueDate         DateTime?        @map("due_date") @db.Date
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  contact         Contact          @relation(fields: [contactId], references: [id], onDelete: Restrict)
  settlements     LoanSettlement[]

  @@index([userId, status], name: "idx_user_loan_status")
  @@index([userId, contactId], name: "idx_user_contact_loan")
  @@map("loans")
}

model LoanSettlement {
  id             String        @id @default(uuid())
  loanId         String        @map("loan_id")
  amount         Decimal       @db.Decimal(12, 2)
  paymentMethod  PaymentMethod @map("payment_method")
  settlementDate DateTime      @map("settlement_date") @db.Date
  notes          String?
  createdAt      DateTime      @default(now()) @map("created_at")

  loan           Loan          @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@index([loanId], name: "idx_settlement_loan")
  @@map("loan_settlements")
}
